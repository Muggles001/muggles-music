<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lx_glass_regular" />
            <corners android:radius="@dimen/lx_radius_panel" />
            <stroke android:width="@dimen/lx_stroke_hairline" android:color="@color/lx_glass_edge" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/lx_glass_highlight"
                android:centerY="0.18"
                android:centerColor="@color/lx_glass_specular_mid"
                android:endColor="@color/lx_glass_specular_clear" />
            <corners android:radius="@dimen/lx_radius_panel" />
        </shape>
    </item>
</layer-list>
