<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#99000000" />
            <stroke
                android:width="1dp"
                android:color="#52FFFFFF" />
            <padding
                android:left="18dp"
                android:top="12dp"
                android:right="18dp"
                android:bottom="12dp" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="1dp"
        android:right="2dp"
        android:bottom="26dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="26dp"
                android:topRightRadius="26dp" />
            <gradient
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
