<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"><shape><solid android:color="@color/lx_disabled_fill" /><corners android:radius="@dimen/lx_radius_control" /></shape></item>
    <item android:state_pressed="true"><shape><solid android:color="@color/lx_brand_pressed" /><corners android:radius="@dimen/lx_radius_control" /></shape></item>
    <item android:state_focused="true"><shape><solid android:color="@color/lx_brand" /><stroke android:width="@dimen/lx_stroke_focus" android:color="@color/lx_focus_ring_strong" /><corners android:radius="@dimen/lx_radius_control" /></shape></item>
    <item><shape><solid android:color="@color/lx_brand" /><corners android:radius="@dimen/lx_radius_control" /></shape></item>
</selector>
