<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Full-page mint-to-white backdrop. Panels are intentionally translucent
         so this transition remains visible through the glass surfaces. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F3FAF6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FFFFFFFF"
                android:endColor="#9FE4C2" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.10"
                android:centerY="0.04"
                android:gradientRadius="620dp"
                android:startColor="#CCFFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.90"
                android:centerY="0.78"
                android:gradientRadius="760dp"
                android:startColor="#6620C878"
                android:endColor="#0020C878" />
        </shape>
    </item>
</layer-list>
