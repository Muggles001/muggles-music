<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lx_brand_pressed" />
            <corners android:radius="@dimen/lx_radius_small" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/lx_bg_focus" />
            <corners android:radius="@dimen/lx_radius_small" />
            <stroke android:width="@dimen/lx_stroke_focus" android:color="@color/lx_focus_ring_strong" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/lx_glass_floating" />
            <corners android:radius="@dimen/lx_radius_small" />
            <stroke android:width="@dimen/lx_stroke_hairline" android:color="@color/lx_border" />
        </shape>
    </item>
</selector>
