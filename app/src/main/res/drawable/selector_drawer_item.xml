<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <!-- DrawerSongAdapter switches focused text to black. -->
            <solid android:color="@color/lx_brand_pale" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/lx_focus_ring" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/lx_bg_panel" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="@color/lx_border" />
        </shape>
    </item>
</selector>
