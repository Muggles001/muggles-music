<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_keyboard_popup"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/layoutTipSuggestions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:paddingBottom="6dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTipSuggestions"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnCloseTips"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_keyboard_key_action"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:padding="4dp"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutModeSwitch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <Button
            android:id="@+id/btnModePinYin"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_keyboard_key_action"
            android:text="拼音"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnModeAbc"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_keyboard_key"
            android:text="abc"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:focusable="true" />

        <Button
            android:id="@+id/btnMode123"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_keyboard_key"
            android:text="123"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutKeyboardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/layoutRow1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/layoutRow2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp" />

        <LinearLayout
            android:id="@+id/layoutRow3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:id="@+id/layoutRow4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>