<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- Top Left Header: Logo + Settings -->
    <LinearLayout
        android:id="@+id/layoutHeaderLeft"
        android:layout_width="300dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:background="#40000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="菠萝音乐"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F3F4F6"
            android:layout_marginStart="12dp"/>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_focused_circle"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="#9CA3AF"
            android:focusable="true"
            android:nextFocusDown="@+id/rvPlaylists"
            android:nextFocusRight="@+id/rvSongs"
            android:contentDescription="Settings" />

    </LinearLayout>

    <!-- Top Right Header: Playlist Name + Count -->
    <LinearLayout
        android:id="@+id/layoutHeaderRight"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintStart_toEndOf="@+id/layoutHeaderLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvPlaylistTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="所有歌曲"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#F3F4F6"
            android:focusable="true" 
            android:focusableInTouchMode="false"
            android:nextFocusLeft="@+id/btnSettings"
            android:nextFocusDown="@+id/rvSongs"/>

        <TextView
            android:id="@+id/tvSongCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 首歌曲"
            android:textSize="14sp"
            android:textColor="#9CA3AF" />

    </LinearLayout>

    <!-- Left Column: Playlists + Mini Player -->
    <LinearLayout
        android:id="@+id/leftColumn"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="#40000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderLeft"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Playlists List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPlaylists"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp"
            android:nextFocusUp="@+id/btnSettings"
            android:nextFocusRight="@+id/rvSongs"/>

    </LinearLayout>

    <!-- Main Content: Songs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSongs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        android:nextFocusLeft="@+id/rvPlaylists"
        android:nextFocusUp="@+id/tvPlaylistTitle"
        app:layout_constraintStart_toEndOf="@+id/leftColumn"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderRight"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
