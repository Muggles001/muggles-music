<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutMiniPlayer"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:background="#E6111827"
    android:elevation="8dp"
    android:padding="8dp"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/btnOpenPlayer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/selector_item_bg"
        android:focusable="true"
        android:clickable="true"
        android:padding="6dp"
        android:nextFocusUp="@id/rvSearchResults"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnPlayPause">

        <androidx.cardview.widget.CardView
            android:id="@+id/cvCurrentCover"
            android:layout_width="48dp"
            android:layout_height="48dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#374151">

            <ImageView
                android:id="@+id/ivCurrentCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="cover" />

            <androidx.cardview.widget.CardView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_gravity="center"
                app:cardCornerRadius="6dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#111827" />

        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvCurrentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Not Playing"
                android:textColor="#F3F4F6"
                android:textSize="14sp"
                android:textStyle="bold"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:duplicateParentState="true" />

            <TextView
                android:id="@+id/tvCurrentArtist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="--:-- / --:--"
                android:textColor="#9CA3AF"
                android:textSize="12sp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:singleLine="true"
                android:duplicateParentState="true" />

        </LinearLayout>

    </LinearLayout>

    <ImageButton
        android:id="@+id/btnPlayPause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/btn_focused_circle"
        android:src="@drawable/ic_play"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:stateListAnimator="@null"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/btnNext"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="play/pause"/>

    <ImageButton
        android:id="@+id/btnNext"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/btn_focused_circle"
        android:src="@drawable/ic_skip_next"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:stateListAnimator="@null"
        android:focusable="true"
        android:layout_marginEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="next"/>

</androidx.constraintlayout.widget.ConstraintLayout>
