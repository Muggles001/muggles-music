<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:nextFocusLeft="@id/tabSongSquare">

    <LinearLayout
        android:id="@+id/layoutSquareTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_title_height"
        android:orientation="vertical"
        android:gravity="top"
        android:paddingStart="@dimen/lx_title_gutter"
        android:paddingEnd="@dimen/lx_title_gutter"
        android:paddingTop="@dimen/lx_title_top"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="歌单广场"
            android:textColor="@color/lx_text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="探索不同平台的精选歌单"
            android:textColor="@color/lx_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Source List (Platform) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSourceList"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_secondary_nav_height"
        android:layout_marginStart="@dimen/lx_nav_gutter"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/lx_nav_gutter"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_floating_glass"
        android:elevation="8dp"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:nextFocusLeft="@id/tabSongSquare"
        app:layout_constraintTop_toBottomOf="@id/layoutSquareTitle" />

    <!-- Playlist Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylists"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:descendantFocusability="afterDescendants"
        android:nextFocusDown="@id/btnNextPage"
        android:nextFocusLeft="@id/tabSongSquare"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@+id/rvSourceList"
        app:layout_constraintBottom_toTopOf="@+id/pagerBar" />

    <LinearLayout
        android:id="@+id/pagerBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_pager_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnPrevPage"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@drawable/bg_btn_secondary"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="@color/lx_text_primary"
            android:focusable="true"
            android:nextFocusUp="@id/rvPlaylists"
            android:nextFocusRight="@id/btnNextPage"
            android:nextFocusDown="@id/tabSongSquare" />

        <TextView
            android:id="@+id/tvPageNumber"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/lx_text_secondary" />

        <ImageButton
            android:id="@+id/btnNextPage"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_right"
            android:background="@drawable/bg_btn_secondary"
            android:scaleType="centerInside"
            android:padding="12dp"
            app:tint="@color/lx_text_primary"
            android:focusable="true"
            android:nextFocusUp="@id/rvPlaylists"
            android:nextFocusLeft="@id/btnPrevPage"
            android:nextFocusDown="@id/tabSongSquare" />
    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
