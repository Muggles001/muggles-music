<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:nextFocusLeft="@id/tabSearch">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/ic_back"
        android:background="@drawable/btn_focused_circle"
        android:scaleType="centerInside"
        android:padding="8dp"
        android:contentDescription="返回"
        android:layout_margin="24dp"
        android:focusable="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/lx_text_primary" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="搜索音乐"
        android:textColor="@color/lx_text_primary"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginStart="@dimen/lx_title_gutter"
        android:layout_marginTop="@dimen/lx_title_top" />

    <TextView
        android:id="@+id/tvSearchSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="从多个音乐平台查找歌曲、歌手和专辑"
        android:textColor="@color/lx_text_secondary"
        android:textSize="13sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        android:layout_marginStart="@dimen/lx_title_gutter"
        android:layout_marginTop="4dp" />

    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="22dp"
        android:layout_marginStart="@dimen/lx_title_gutter"
        android:layout_marginEnd="@dimen/lx_title_gutter"
        android:nextFocusLeft="@id/tabSearch"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvSearchSubtitle">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/bg_input_field"
            android:elevation="6dp"
            android:outlineProvider="background"
            android:hint="输入歌曲名、歌手名..."
            android:textColor="@color/lx_text_primary"
            android:textColorHint="@color/lx_text_muted"
            android:textSize="17sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:imeOptions="actionSearch"
            android:singleLine="true"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusLeft="@id/tabSearch"
            android:nextFocusRight="@id/btnClear" />

        <ImageButton
            android:id="@+id/btnClear"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_btn_primary"
            android:src="@drawable/ic_delete"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:contentDescription="清空"
            android:focusable="true"
            android:nextFocusLeft="@id/etSearch"
            android:nextFocusRight="@id/btnSearch" />

        <Button
            android:id="@+id/btnSearch"
            android:layout_width="88dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_primary"
            android:text="搜索"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:focusable="true"
            android:nextFocusLeft="@id/btnClear"
            android:nextFocusRight="@id/btnScan" />

        <ImageButton
            android:id="@+id/btnScan"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_btn_primary"
            android:src="@drawable/ic_qr_code"
            android:scaleType="centerInside"
            android:padding="10dp"
            android:contentDescription="扫码搜索"
            android:focusable="true"
            android:nextFocusLeft="@id/btnSearch" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSourceList"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_secondary_nav_height"
        android:layout_marginTop="14dp"
        android:layout_marginStart="@dimen/lx_nav_gutter"
        android:layout_marginEnd="@dimen/lx_nav_gutter"
        android:layout_marginBottom="4dp"
        android:nextFocusLeft="@id/tabSearch"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/bg_floating_glass"
        android:elevation="8dp"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSearch" />



    <TextView
        android:id="@+id/tvHotSearchTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="热搜"
        android:textColor="@color/lx_text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvSourceList" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHotSearch"
        android:layout_width="0dp"
        android:layout_height="32dp"
        android:layout_marginTop="6dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvHotSearchTitle" />

    <TextView
        android:id="@+id/tvResultCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="共 0 首"
        android:textColor="@color/lx_text_secondary"
        android:textSize="12sp"
        android:layout_marginTop="14dp"
        android:layout_marginStart="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rvHotSearch" />

    <LinearLayout
        android:id="@+id/layoutSearchActions"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginStart="32dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="32dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResultCount">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="播放控制"
            android:textColor="@color/lx_text_secondary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnSearchPlayAll"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/btn_focused_circle"
            android:contentDescription="播放全部搜索结果"
            android:focusable="true"
            android:nextFocusLeft="@id/tabSearch"
            android:nextFocusRight="@id/btnSearchPlayOrderToggle"
            android:nextFocusDown="@id/rvSearchResults"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play"
            app:tint="@color/lx_text_primary" />

        <ImageButton
            android:id="@+id/btnSearchPlayOrderToggle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/btn_focused_circle"
            android:contentDescription="切换为随机播放"
            android:focusable="true"
            android:nextFocusLeft="@id/btnSearchPlayAll"
            android:nextFocusDown="@id/rvSearchResults"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_repeat"
            app:tint="@color/lx_text_primary" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSearchPager"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_pager_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnSearchPrevPage"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@drawable/bg_btn_secondary"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:focusable="true"
            android:nextFocusUp="@id/rvSearchResults"
            android:nextFocusRight="@id/btnSearchNextPage"
            android:nextFocusDown="@id/tabSearch"
            android:contentDescription="上一页"
            app:tint="@color/lx_text_primary" />

        <TextView
            android:id="@+id/tvSearchPageNumber"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/lx_text_secondary" />

        <ImageButton
            android:id="@+id/btnSearchNextPage"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_right"
            android:background="@drawable/bg_btn_secondary"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:focusable="true"
            android:nextFocusUp="@id/rvSearchResults"
            android:nextFocusLeft="@id/btnSearchPrevPage"
            android:nextFocusDown="@id/tabSearch"
            android:contentDescription="下一页"
            app:tint="@color/lx_text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvNoResults"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="暂无搜索结果"
        android:textColor="@color/lx_text_secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResultCount"
        app:layout_constraintBottom_toBottomOf="parent" />

    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvResultCount"
        app:layout_constraintBottom_toBottomOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSearchResults"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        android:clipToPadding="false"
        android:clipToOutline="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:descendantFocusability="afterDescendants"
        android:background="@drawable/bg_content_panel"
        android:nextFocusLeft="@id/tabSearch"
        android:nextFocusUp="@id/btnSearchPlayAll"
        android:nextFocusDown="@id/btnSearchNextPage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutSearchActions"
        app:layout_constraintBottom_toTopOf="@id/layoutSearchPager" />

</androidx.constraintlayout.widget.ConstraintLayout>
