<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="220dp"
    android:layout_height="@dimen/lx_control_standard"
    android:layout_marginEnd="@dimen/lx_space_sm"
    android:paddingStart="@dimen/lx_space_md"
    android:paddingEnd="@dimen/lx_space_md"
    android:paddingTop="@dimen/lx_space_sm"
    android:paddingBottom="@dimen/lx_space_sm"
    android:orientation="horizontal"
    android:background="@drawable/selector_item_bg"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/lx_icon_default"
        android:layout_height="@dimen/lx_icon_default"
        android:src="@drawable/ic_playlist_music"
        app:tint="@color/selector_selectable_content"
        android:duplicateParentState="true"
        android:contentDescription="icon"/>

    <TextView
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/lx_space_sm"
        android:text="Playlist Name"
        android:textSize="@dimen/lx_type_body"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/selector_selectable_content"
        android:duplicateParentState="true"/>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/lx_space_sm"
        android:paddingStart="@dimen/lx_space_sm"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/lx_space_sm"
        android:paddingBottom="2dp"
        android:background="@drawable/bg_count_chip"
        android:text="0"
        android:textSize="@dimen/lx_type_caption"
        android:textColor="@color/selector_action_secondary_content"
        android:duplicateParentState="true" />

</LinearLayout>
