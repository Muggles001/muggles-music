<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/item_song_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="@dimen/lx_space_xxs"
    android:layout_marginBottom="@dimen/lx_space_xxs"
    android:gravity="center_vertical"
    android:background="@drawable/selector_item_bg"
    android:clickable="true"
    android:focusable="true"
    android:descendantFocusability="afterDescendants"
    android:paddingStart="@dimen/lx_space_md"
    android:paddingEnd="@dimen/lx_space_md"
    android:minHeight="@dimen/lx_list_row_height">

    <FrameLayout
        android:layout_width="@dimen/lx_icon_default"
        android:layout_height="@dimen/lx_icon_default">
        
        <TextView
            android:id="@+id/tvIndex"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/selector_action_secondary_content"
            android:fontFamily="monospace"
            android:textSize="@dimen/lx_type_caption"
            android:duplicateParentState="true"/>

        <ImageView
            android:id="@+id/ivEqualizer"
            android:layout_width="@dimen/lx_icon_small"
            android:layout_height="@dimen/lx_icon_small"
            android:layout_gravity="center"
            android:src="@drawable/ic_equalizer"
            android:visibility="gone"
            app:tint="@color/lx_brand"
            android:contentDescription="playing"/>
    </FrameLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/lx_list_cover_size"
        android:layout_height="@dimen/lx_list_cover_size"
        android:layout_marginStart="@dimen/lx_space_xs"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="@dimen/lx_radius_small"
        app:cardElevation="0dp">
        <ImageView
            android:id="@+id/ivCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="cover"/>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/lx_space_sm"
        android:gravity="center_vertical"
        android:duplicateParentState="true">

        <TextView
            android:id="@+id/tvSongName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Song Title"
            android:textColor="@color/selector_selectable_content"
            android:textSize="@dimen/lx_type_control"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            android:duplicateParentState="true"/>

        <TextView
            android:id="@+id/tvArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Unknown Artist"
            android:textColor="@color/selector_action_secondary_content"
            android:textSize="@dimen/lx_type_caption"
            android:maxLines="1"
            android:ellipsize="end"
            android:duplicateParentState="true"/>

        <TextView
            android:id="@+id/tvSource"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/selector_selectable_content"
            android:textSize="@dimen/lx_type_caption"
            android:layout_marginTop="0dp"
            android:duplicateParentState="true"/>

    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/lx_space_xxs">

        <ImageButton
            android:id="@+id/btnItemPlay"
            android:layout_width="@dimen/lx_control_compact"
            android:layout_height="@dimen/lx_control_compact"
            android:layout_marginEnd="@dimen/lx_space_xxs"
            android:background="@drawable/btn_focused_circle"
            android:src="@drawable/ic_play"
            android:scaleType="fitCenter"
            android:padding="@dimen/lx_space_sm"
            app:tint="@color/selector_action_content"
            android:focusable="true"
            android:contentDescription="play"/>

        <ImageButton
            android:id="@+id/btnItemFullscreen"
            android:layout_width="@dimen/lx_control_compact"
            android:layout_height="@dimen/lx_control_compact"
            android:layout_marginEnd="@dimen/lx_space_xxs"
            android:background="@drawable/btn_focused_circle"
            android:src="@drawable/ic_fullscreen"
            android:scaleType="fitCenter"
            android:padding="@dimen/lx_space_sm"
            app:tint="@color/selector_action_content"
            android:focusable="true"
            android:contentDescription="fullscreen"/>

        <ImageButton
            android:id="@+id/btnItemFav"
            android:layout_width="@dimen/lx_control_compact"
            android:layout_height="@dimen/lx_control_compact"
            android:layout_marginEnd="@dimen/lx_space_xxs"
            android:background="@drawable/btn_focused_circle"
            android:src="@drawable/ic_favorite_border"
            android:scaleType="fitCenter"
            android:padding="@dimen/lx_space_sm"
            app:tint="@color/selector_action_content"
            android:focusable="true"
            android:contentDescription="favorite"/>

        <ImageButton
            android:id="@+id/btnItemDelete"
            android:layout_width="@dimen/lx_control_compact"
            android:layout_height="@dimen/lx_control_compact"
            android:background="@drawable/btn_focused_circle"
            android:src="@drawable/ic_delete"
            android:scaleType="fitCenter"
            android:padding="@dimen/lx_space_sm"
            app:tint="@color/selector_action_content"
            android:focusable="true"
            android:contentDescription="delete"/>

    </LinearLayout>

</LinearLayout>
