<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- Left Panel: Branding -->
    <LinearLayout
        android:id="@+id/panelLeft"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.42"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="Logo"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="麻瓜音乐"
            android:textColor="@color/lx_text_primary"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Android TV 音乐客户端"
            android:textColor="@color/lx_text_secondary"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="支持直连 LX 音源与 LXserver"
            android:textColor="@color/lx_text_muted"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- Mode Toggle Button -->
        <Button
            android:id="@+id/btnToggleMode"
            android:layout_width="@dimen/lx_button_wide_width"
            android:layout_height="@dimen/lx_control_standard"
            android:text="扫码配置"
            android:textColor="@color/selector_primary_button_text"
            android:background="@drawable/bg_btn_primary"
            android:paddingStart="@dimen/lx_space_lg"
            android:paddingEnd="@dimen/lx_space_lg"
            android:focusable="true"
            android:nextFocusRight="@+id/etUrl" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="@color/lx_border"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintStart_toEndOf="@+id/panelLeft"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Right Panel: Form -->
    <ScrollView
        android:id="@+id/panelRight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选择使用方式"
            android:textColor="@color/lx_text_secondary"
            android:textSize="@dimen/lx_type_body"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/lx_control_standard"
            android:orientation="horizontal"
            android:layout_marginBottom="@dimen/lx_space_lg">

            <Button
                android:id="@+id/btnModeDirect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="直接使用音源"
                android:textColor="@color/selector_selectable_content"
                android:background="@drawable/selector_tab_bg"
                android:focusable="true"
                android:nextFocusDown="@id/etSourceUrl"
                android:nextFocusLeft="@id/btnToggleMode"
                android:nextFocusRight="@id/btnModeServer" />

            <Button
                android:id="@+id/btnModeServer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/lx_space_sm"
                android:text="连接 LXserver"
                android:textColor="@color/selector_selectable_content"
                android:background="@drawable/selector_tab_bg"
                android:focusable="true"
                android:nextFocusDown="@id/etUrl"
                android:nextFocusLeft="@id/btnModeDirect"
                android:nextFocusRight="@id/btnModeServer" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutDirect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LX 自定义音源脚本地址"
                android:textColor="@color/lx_text_secondary"
                android:textSize="@dimen/lx_type_body"
                android:layout_marginBottom="@dimen/lx_space_xs" />

            <EditText
                android:id="@+id/etSourceUrl"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_control_standard"
                android:background="@drawable/bg_input_field"
                android:hint="例如 https://example.com/source.js"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/lx_text_primary"
                android:textColorHint="@color/lx_text_muted"
                android:textSize="@dimen/lx_type_control"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusUp="@id/btnModeDirect"
                android:nextFocusDown="@id/btnImportSource"
                android:nextFocusLeft="@id/btnToggleMode"
                android:nextFocusRight="@id/etSourceUrl" />

            <Button
                android:id="@+id/btnImportSource"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_control_standard"
                android:layout_marginTop="@dimen/lx_space_lg"
                android:background="@drawable/bg_btn_primary"
                android:text="下载、检测并启用"
                android:textColor="@color/selector_primary_button_text"
                android:textSize="@dimen/lx_type_control"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:focusable="true"
                android:nextFocusUp="@id/etSourceUrl"
                android:nextFocusDown="@id/etSourceUrl"
                android:nextFocusLeft="@id/btnToggleMode"
                android:nextFocusRight="@id/btnImportSource" />

            <TextView
                android:id="@+id/tvSourceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="音源将在电视本地运行；127.0.0.1 表示电视本机。"
                android:textColor="@color/lx_text_muted"
                android:textSize="@dimen/lx_type_body" />

            <Button
                android:id="@+id/btnRollbackSource"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_control_standard"
                android:layout_marginTop="@dimen/lx_space_md"
                android:background="@drawable/bg_btn_secondary"
                android:text="回滚到上一版音源"
                android:textColor="@color/selector_action_content"
                android:visibility="gone"
                android:focusable="true"
                android:nextFocusUp="@id/btnImportSource"
                android:nextFocusDown="@id/etSourceUrl"
                android:nextFocusLeft="@id/btnToggleMode"
                android:nextFocusRight="@id/btnRollbackSource" />
        </LinearLayout>

        <!-- Manual Login Container -->
        <LinearLayout
            android:id="@+id/layoutManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Server URL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="服务地址"
                android:textColor="@color/lx_text_secondary"
                android:textSize="@dimen/lx_type_body"
                android:layout_marginBottom="@dimen/lx_space_xs" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_control_standard"
                android:background="@drawable/bg_input_field"
                android:hint="例如 http://192.168.1.100:9527"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/lx_text_primary"
                android:textColorHint="@color/lx_text_muted"
                android:textSize="@dimen/lx_type_control"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/etUsername"
                android:nextFocusUp="@+id/btnConnect"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/etUrl"
                android:layout_marginBottom="16dp" />

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="lxserver 用户名"
                android:textColor="@color/lx_text_secondary"
                android:textSize="@dimen/lx_type_body"
                android:layout_marginBottom="@dimen/lx_space_xs" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_control_standard"
                android:background="@drawable/bg_input_field"
                android:hint="请输入用户名"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/lx_text_primary"
                android:textColorHint="@color/lx_text_muted"
                android:textSize="@dimen/lx_type_control"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/etPassword"
                android:nextFocusUp="@+id/etUrl"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/etUsername"
                android:layout_marginBottom="16dp" />

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="lxserver 密码"
                android:textColor="@color/lx_text_secondary"
                android:textSize="@dimen/lx_type_body"
                android:layout_marginBottom="@dimen/lx_space_xs" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_control_standard"
                android:background="@drawable/bg_input_field"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/lx_text_primary"
                android:textColorHint="@color/lx_text_muted"
                android:textSize="@dimen/lx_type_control"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/etToken"
                android:nextFocusUp="@+id/etUsername"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/etPassword"
                android:layout_marginBottom="16dp" />

            <!-- Token -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户 Token (选填)"
                android:textColor="@color/lx_text_secondary"
                android:textSize="@dimen/lx_type_body"
                android:layout_marginBottom="@dimen/lx_space_xs" />

            <EditText
                android:id="@+id/etToken"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_control_standard"
                android:background="@drawable/bg_input_field"
                android:hint="请输入用户 Token"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/lx_text_primary"
                android:textColorHint="@color/lx_text_muted"
                android:textSize="@dimen/lx_type_control"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/btnConnect"
                android:nextFocusUp="@+id/etPassword"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/etToken"
                android:layout_marginBottom="28dp" />

            <!-- Connect Button -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_control_standard"
                android:background="@drawable/bg_btn_primary"
                android:text="连接 lxserver"
                android:textColor="@color/selector_primary_button_text"
                android:textSize="@dimen/lx_type_control"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:focusable="true"
                android:nextFocusDown="@+id/etUrl"
                android:nextFocusUp="@+id/etPassword"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/btnConnect" />

            <!-- Help Text -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="如何获取服务器地址？\n请运行 lxserver 服务，在控制台查看地址"
                android:textColor="@color/lx_text_muted"
                android:textSize="12sp"
                android:gravity="start"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="如何获取账号密码？\n在 lxserver 的[管理控制台]中配置用户"
                android:textColor="@color/lx_text_muted"
                android:textSize="12sp"
                android:gravity="start" />

        </LinearLayout>

        <!-- QR Login Container -->
        <LinearLayout
            android:id="@+id/layoutQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:background="@drawable/bg_input_field"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvScanHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机扫码配置服务器"
                android:textColor="@color/lx_text_primary"
                android:textSize="18sp"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/tvIpAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在获取地址..."
                android:textColor="@color/lx_text_secondary"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
