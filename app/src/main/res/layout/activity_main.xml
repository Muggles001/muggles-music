<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- TV shell: a stable left rail keeps primary navigation reachable with one
         horizontal move from every content page. -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="@dimen/lx_rail_width"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/lx_space_md"
        android:paddingTop="@dimen/lx_space_lg"
        android:paddingEnd="@dimen/lx_space_md"
        android:paddingBottom="@dimen/lx_space_md"
        android:background="@drawable/bg_nav_rail"
        android:elevation="@dimen/lx_elevation_surface"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:layout_marginStart="@dimen/lx_shell_margin"
        android:layout_marginTop="@dimen/lx_shell_margin"
        android:layout_marginBottom="@dimen/lx_shell_margin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:id="@+id/navBrand"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lx_primary_item_height"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/lx_space_sm"
            android:paddingEnd="@dimen/lx_space_sm">

            <ImageView
                android:layout_width="@dimen/lx_icon_large"
                android:layout_height="@dimen/lx_icon_large"
                android:src="@drawable/ic_logo"
                android:scaleType="centerCrop"
                android:contentDescription="麻瓜音乐" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="@dimen/lx_space_sm">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="麻瓜音乐"
                    android:textColor="@color/lx_text_primary"
                    android:textSize="@dimen/lx_type_control"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="MUGGLES MUSIC"
                    android:textColor="@color/lx_text_muted"
                    android:textSize="@dimen/lx_type_caption"
                    android:letterSpacing="0.12" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="@dimen/lx_space_md"
            android:layout_marginBottom="@dimen/lx_space_md"
            android:background="@color/lx_border" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/lx_space_sm"
            android:layout_marginBottom="@dimen/lx_space_xs"
            android:text="浏览"
            android:textColor="@color/lx_text_muted"
            android:textSize="@dimen/lx_type_caption"
            android:textStyle="bold" />

        <ScrollView
            android:id="@+id/navScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="vertical"
            android:fadeScrollbars="false"
            android:scrollbarSize="4dp"
            android:paddingEnd="@dimen/lx_space_sm"
            android:clipToPadding="false"
            android:scrollbarThumbVertical="@drawable/scrollbar_thumb">

        <LinearLayout
            android:id="@+id/navItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/tabSongSquare"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_primary_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/lx_space_md"
                android:paddingEnd="@dimen/lx_space_md"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@id/rvSourceList"
                android:background="@drawable/selector_nav_item">

                <ImageButton
                    android:id="@+id/btnSongSquare"
                    android:layout_width="@dimen/lx_icon_default"
                    android:layout_height="@dimen/lx_icon_default"
                    android:src="@drawable/ic_playlist"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    app:tint="@color/selector_nav_tint"
                    android:contentDescription="歌单广场" />

                <TextView
                    android:id="@+id/tvSongSquare"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lx_space_sm"
                    android:text="歌单广场"
                    android:textSize="@dimen/lx_type_body"
                    android:duplicateParentState="true"
                    android:textColor="@color/selector_nav_tint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSearch"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_primary_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/lx_space_md"
                android:paddingEnd="@dimen/lx_space_md"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@id/etSearch"
                android:background="@drawable/selector_nav_item">

                <ImageButton
                    android:id="@+id/btnSearch"
                    android:layout_width="@dimen/lx_icon_default"
                    android:layout_height="@dimen/lx_icon_default"
                    android:src="@drawable/ic_search"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    app:tint="@color/selector_nav_tint"
                    android:contentDescription="搜索" />

                <TextView
                    android:id="@+id/tvSearch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lx_space_sm"
                    android:text="搜索"
                    android:textSize="@dimen/lx_type_body"
                    android:duplicateParentState="true"
                    android:textColor="@color/selector_nav_tint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabRanking"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_primary_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/lx_space_md"
                android:paddingEnd="@dimen/lx_space_md"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@id/rvBoards"
                android:background="@drawable/selector_nav_item">

                <ImageButton
                    android:id="@+id/btnRanking"
                    android:layout_width="@dimen/lx_icon_default"
                    android:layout_height="@dimen/lx_icon_default"
                    android:src="@drawable/ic_ranking"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    app:tint="@color/selector_nav_tint"
                    android:contentDescription="排行榜" />

                <TextView
                    android:id="@+id/tvRanking"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lx_space_sm"
                    android:text="排行榜"
                    android:textSize="@dimen/lx_type_body"
                    android:duplicateParentState="true"
                    android:textColor="@color/selector_nav_tint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabLibrary"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_primary_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/lx_space_md"
                android:paddingEnd="@dimen/lx_space_md"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@id/tabAllSongs"
                android:background="@drawable/selector_nav_item">

                <ImageButton
                    android:id="@+id/btnLibrary"
                    android:layout_width="@dimen/lx_icon_default"
                    android:layout_height="@dimen/lx_icon_default"
                    android:src="@drawable/ic_favorite"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    app:tint="@color/selector_nav_tint"
                    android:contentDescription="我的歌单" />

                <TextView
                    android:id="@+id/tvLibrary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lx_space_sm"
                    android:text="我的歌单"
                    android:textSize="@dimen/lx_type_body"
                    android:duplicateParentState="true"
                    android:textColor="@color/selector_nav_tint" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabSettings"
                android:layout_width="match_parent"
                android:layout_height="@dimen/lx_primary_item_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/lx_space_md"
                android:paddingEnd="@dimen/lx_space_md"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusRight="@id/layoutServerConfig"
                android:background="@drawable/selector_nav_item">

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="@dimen/lx_icon_default"
                    android:layout_height="@dimen/lx_icon_default"
                    android:src="@drawable/ic_settings"
                    android:background="@android:color/transparent"
                    android:scaleType="fitCenter"
                    android:focusable="false"
                    android:duplicateParentState="true"
                    app:tint="@color/selector_nav_tint"
                    android:contentDescription="设置" />

                <TextView
                    android:id="@+id/tvSettings"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/lx_space_sm"
                    android:text="设置"
                    android:textSize="@dimen/lx_type_body"
                    android:duplicateParentState="true"
                    android:textColor="@color/selector_nav_tint" />
            </LinearLayout>
        </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/navFooter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lx_control_compact"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/lx_space_sm"
            android:paddingEnd="@dimen/lx_space_sm">

            <View
                android:layout_width="@dimen/lx_space_xs"
                android:layout_height="@dimen/lx_space_xs"
                android:background="@drawable/bg_count_chip" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/lx_space_xs"
                android:text="已连接到音乐服务"
                android:textColor="@color/lx_text_muted"
                android:textSize="@dimen/lx_type_caption" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/lx_content_gap"
        android:nextFocusLeft="@id/tabSongSquare"
        app:layout_constraintStart_toEndOf="@id/bottomNav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
