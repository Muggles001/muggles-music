<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- Fragment Container -->
    <FrameLayout
        android:id="@+id/fragmentContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/bottomNav" />

    <!-- Bottom Navigation -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#E6111827"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- 搜索 -->
        <LinearLayout
            android:id="@+id/tabSearch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tab_bg">

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_search"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:alpha="0.5"
                app:tint="#FFFFFF"
                android:contentDescription="搜索" />

            <TextView
                android:id="@+id/tvSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="搜索"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 歌单广场 -->
        <LinearLayout
            android:id="@+id/tabSongSquare"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tab_bg">

            <ImageButton
                android:id="@+id/btnSongSquare"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_playlist"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:alpha="0.5"
                app:tint="#FFFFFF"
                android:contentDescription="歌单广场" />

            <TextView
                android:id="@+id/tvSongSquare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="歌单广场"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 排行榜 -->
        <LinearLayout
            android:id="@+id/tabRanking"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tab_bg">

            <ImageButton
                android:id="@+id/btnRanking"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_ranking"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:alpha="0.5"
                app:tint="#FFFFFF"
                android:contentDescription="排行榜" />

            <TextView
                android:id="@+id/tvRanking"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="排行榜"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 我的歌单 -->
        <LinearLayout
            android:id="@+id/tabLibrary"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tab_bg">

            <ImageButton
                android:id="@+id/btnLibrary"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_favorite"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:alpha="0.5"
                app:tint="#FFFFFF"
                android:contentDescription="我的歌单" />

            <TextView
                android:id="@+id/tvLibrary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的歌单"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 设置 -->
        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:background="@drawable/selector_tab_bg">

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_settings"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:alpha="0.5"
                app:tint="#FFFFFF"
                android:contentDescription="设置" />

            <TextView
                android:id="@+id/tvSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="设置"
                android:textSize="12sp"
                android:textColor="#9CA3AF"
                android:layout_marginTop="4dp" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
