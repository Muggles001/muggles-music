<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg"
    tools:context=".PlayerActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivBlurBackground"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:scaleX="1.65"
            android:scaleY="1.65"
            android:src="@drawable/ic_album_placeholder"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/viewOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_player_atmosphere_overlay"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <top.boluofan.musictv.player.visual.AsciiRibbonView
            android:id="@+id/asciiRibbonView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideSplit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.5" />

        <View
            android:id="@+id/viewLyricsScrim"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_player_lyrics_scrim"
            android:importantForAccessibility="no"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideSplit" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideSceneBottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.82" />

        <top.boluofan.musictv.player.visual.SpatialLyricsView
            android:id="@+id/spatialLyricsView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:paddingTop="36dp"
            android:paddingBottom="36dp"
            android:focusable="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideSplit" />

        <TextView
            android:id="@+id/tvNoLyrics"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无歌词"
            android:textColor="@color/player_text_muted"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guideSplit" />

        <top.boluofan.musictv.player.visual.VinylTurntableView
            android:id="@+id/vinylTurntableView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:layout_constraintWidth_percent="0.35"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tvBigTitle"
            app:layout_constraintStart_toEndOf="@id/guideSplit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <top.boluofan.musictv.ui.player.MarqueeTextView
            android:id="@+id/tvBigTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Song Title"
            android:textColor="@color/player_text_primary"
            android:textSize="30sp"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"
            app:layout_constraintWidth_percent="0.36"
            app:layout_constraintTop_toBottomOf="@id/vinylTurntableView"
            app:layout_constraintBottom_toTopOf="@id/tvBigArtist"
            app:layout_constraintStart_toEndOf="@id/guideSplit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.35" />

        <top.boluofan.musictv.ui.player.MarqueeTextView
            android:id="@+id/tvBigArtist"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Artist Name"
            android:textColor="@color/player_text_secondary"
            android:textSize="20sp"
            android:gravity="center"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            app:layout_constraintWidth_percent="0.28"
            app:layout_constraintTop_toBottomOf="@id/tvBigTitle"
            app:layout_constraintBottom_toTopOf="@id/guideSceneBottom"
            app:layout_constraintStart_toEndOf="@id/guideSplit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.40" />

        <LinearLayout
            android:id="@+id/layoutSeekProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:visibility="gone"
            android:elevation="20dp"
            android:layout_marginBottom="72dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvSeekProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tooltip_rect"
                android:textColor="#111111"
                android:textSize="20sp"
                android:textStyle="bold"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:singleLine="true"
                android:text="▶▶ 00:00 / 00:00" />
        </LinearLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutBottomControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:alpha="0"
            android:translationY="180dp"
            android:visibility="invisible"
            android:background="@drawable/bg_player_control_capsule"
            android:elevation="24dp"
            android:paddingStart="22dp"
            android:paddingTop="14dp"
            android:paddingEnd="22dp"
            android:paddingBottom="12dp"
            app:layout_constraintWidth_percent="0.66"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <top.boluofan.musictv.player.visual.WaveformProgressView
                android:id="@+id/waveformProgressView"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:focusable="true"
                android:contentDescription="播放进度"
                android:nextFocusDown="@id/btnPlayPause"
                android:nextFocusUp="@id/waveformProgressView"
                android:nextFocusLeft="@id/waveformProgressView"
                android:nextFocusRight="@id/waveformProgressView"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                android:id="@+id/layoutPrimaryControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/waveformProgressView"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageButton
                    android:id="@+id/btnQueue"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/btn_focused_circle"
                    android:src="@drawable/ic_queue_music"
                    android:padding="15dp"
                    android:contentDescription="播放列表"
                    android:focusable="true"
                    android:nextFocusUp="@id/waveformProgressView"
                    android:nextFocusLeft="@id/btnQueue"
                    android:nextFocusRight="@id/btnPrev"
                    app:tint="@color/selector_player_action_content" />

                <ImageButton
                    android:id="@+id/btnPrev"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_focused_circle"
                    android:src="@drawable/ic_skip_previous"
                    android:padding="16dp"
                    android:contentDescription="上一曲"
                    android:focusable="true"
                    android:nextFocusUp="@id/waveformProgressView"
                    android:nextFocusLeft="@id/btnQueue"
                    android:nextFocusRight="@id/btnPlayPause"
                    app:tint="@color/selector_player_action_content" />

                <ImageButton
                    android:id="@+id/btnPlayPause"
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/btn_focused_circle"
                    android:src="@drawable/ic_play"
                    android:padding="20dp"
                    android:contentDescription="播放或暂停"
                    android:focusable="true"
                    android:nextFocusUp="@id/waveformProgressView"
                    android:nextFocusLeft="@id/btnPrev"
                    android:nextFocusRight="@id/btnNext"
                    app:tint="@color/selector_player_action_content" />

                <ImageButton
                    android:id="@+id/btnNext"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/btn_focused_circle"
                    android:src="@drawable/ic_skip_next"
                    android:padding="16dp"
                    android:contentDescription="下一曲"
                    android:focusable="true"
                    android:nextFocusUp="@id/waveformProgressView"
                    android:nextFocusLeft="@id/btnPlayPause"
                    android:nextFocusRight="@id/btnRepeat"
                    app:tint="@color/selector_player_action_content" />

                <ImageButton
                    android:id="@+id/btnRepeat"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_focused_circle"
                    android:src="@drawable/ic_repeat"
                    android:padding="15dp"
                    android:contentDescription="播放模式"
                    android:focusable="true"
                    android:nextFocusUp="@id/waveformProgressView"
                    android:nextFocusLeft="@id/btnNext"
                    android:nextFocusRight="@id/btnScrape"
                    app:tint="@color/selector_player_action_content" />

                <ImageButton
                    android:id="@+id/btnScrape"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/btn_focused_circle"
                    android:src="@drawable/ic_scrape"
                    android:padding="15dp"
                    android:contentDescription="歌曲信息"
                    android:focusable="true"
                    android:nextFocusUp="@id/waveformProgressView"
                    android:nextFocusLeft="@id/btnRepeat"
                    android:nextFocusRight="@id/btnScrape"
                    app:tint="@color/selector_player_action_content" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <include layout="@layout/view_player_queue_drawer" />
    <include layout="@layout/view_player_option_menu" />
</androidx.constraintlayout.widget.ConstraintLayout>
