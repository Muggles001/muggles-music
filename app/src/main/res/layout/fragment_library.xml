<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:nextFocusLeft="@id/tabLibrary">

    <!-- The primary rail already owns branding and settings. This header only
         identifies the current section. -->
    <LinearLayout
        android:id="@+id/layoutHeaderLeft"
        android:layout_width="320dp"
        android:layout_height="@dimen/lx_title_height"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingStart="@dimen/lx_title_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        android:paddingTop="@dimen/lx_title_top"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="我的歌单"
            android:textSize="@dimen/lx_type_title"
            android:textStyle="bold"
            android:textColor="@color/lx_text_primary" />

        <ImageButton
            android:id="@+id/btnBackToPlaylists"
            android:layout_width="@dimen/lx_control_compact"
            android:layout_height="@dimen/lx_control_compact"
            android:layout_marginStart="@dimen/lx_space_sm"
            android:src="@drawable/ic_back"
            android:background="@drawable/btn_focused_circle"
            android:scaleType="centerInside"
            android:padding="@dimen/lx_space_sm"
            android:visibility="gone"
            android:focusable="true"
            android:contentDescription="返回歌单列表"
            app:tint="@color/selector_action_content" />

    </LinearLayout>

    <!-- Top Right Header: Playlist Name + Count -->
    <LinearLayout
        android:id="@+id/layoutHeaderRight"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_title_height"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        android:paddingTop="@dimen/lx_title_top"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toEndOf="@+id/layoutHeaderLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tab: 全部歌曲 -->
        <TextView
            android:id="@+id/tabAllSongs"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lx_control_compact"
            android:text="全部歌曲"
            android:textSize="@dimen/lx_type_body"
            android:textColor="@color/selector_selectable_content"
            android:gravity="center"
            android:paddingStart="@dimen/lx_space_md"
            android:paddingEnd="@dimen/lx_space_md"
            android:background="@drawable/selector_tab_bg"
            android:focusable="true"
            android:nextFocusLeft="@id/tabLibrary"
            android:nextFocusRight="@id/tabLoveList" />

        <!-- Tab: 我的收藏 -->
        <TextView
            android:id="@+id/tabLoveList"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/lx_control_compact"
            android:text="我的收藏"
            android:textSize="@dimen/lx_type_body"
            android:textColor="@color/selector_selectable_content"
            android:gravity="center"
            android:paddingStart="@dimen/lx_space_md"
            android:paddingEnd="@dimen/lx_space_md"
            android:layout_marginStart="@dimen/lx_space_sm"
            android:background="@drawable/selector_tab_bg"
            android:focusable="true"
            android:nextFocusLeft="@id/tabAllSongs" />

        <View
            android:layout_width="@dimen/lx_space_sm"
            android:layout_height="1dp" />

        <TextView
            android:id="@+id/tvPlaylistTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="歌单"
            android:textSize="@dimen/lx_type_section"
            android:textStyle="bold"
            android:textColor="@color/lx_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tvSongCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 首"
            android:textSize="@dimen/lx_type_body"
            android:textColor="@color/lx_text_secondary"
            android:layout_marginStart="@dimen/lx_space_sm" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/libraryActionBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_secondary_nav_height"
        android:layout_marginStart="@dimen/lx_nav_gutter"
        android:layout_marginTop="@dimen/lx_space_sm"
        android:layout_marginEnd="@dimen/lx_nav_gutter"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        android:background="@drawable/bg_floating_glass"
        android:elevation="@dimen/lx_elevation_surface"
        android:outlineProvider="background"
        android:clipToOutline="true"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderLeft">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="播放控制"
            android:textSize="@dimen/lx_type_body"
            android:textStyle="bold"
            android:textColor="@color/lx_text_secondary" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnPlayAllSongs"
            android:layout_width="@dimen/lx_control_compact"
            android:layout_height="@dimen/lx_control_compact"
            android:src="@drawable/ic_play"
            android:background="@drawable/btn_focused_circle"
            android:scaleType="centerInside"
            android:padding="@dimen/lx_space_sm"
            android:focusable="true"
            android:nextFocusLeft="@id/tabLibrary"
            android:nextFocusRight="@id/btnPlayOrderToggle"
            android:nextFocusDown="@id/rvSongs"
            android:contentDescription="全部播放"
            app:tint="@color/selector_action_content" />

        <ImageButton
            android:id="@+id/btnPlayOrderToggle"
            android:layout_width="@dimen/lx_control_compact"
            android:layout_height="@dimen/lx_control_compact"
            android:layout_marginStart="@dimen/lx_space_sm"
            android:src="@drawable/ic_repeat"
            android:background="@drawable/btn_selectable_circle"
            android:scaleType="centerInside"
            android:padding="@dimen/lx_space_sm"
            android:focusable="true"
            android:nextFocusLeft="@id/btnPlayAllSongs"
            android:nextFocusDown="@id/rvSongs"
            android:contentDescription="切换为随机播放"
            app:tint="@color/selector_selectable_content" />

    </LinearLayout>

    <!-- Secondary selector: keep playlists in a compact horizontal strip so
         the song list has the full content width instead of a second sidebar. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylists"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/lx_nav_gutter"
        android:layout_marginTop="@dimen/lx_space_sm"
        android:layout_marginEnd="@dimen/lx_nav_gutter"
        android:background="@android:color/transparent"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        android:paddingTop="@dimen/lx_space_sm"
        android:paddingBottom="@dimen/lx_space_sm"
        android:clipToPadding="false"
        android:focusable="true"
        android:nextFocusLeft="@id/tabLibrary"
        android:nextFocusDown="@id/btnLibraryNextPage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderLeft"
        app:layout_constraintBottom_toTopOf="@+id/libraryPagerBar" />

    <LinearLayout
        android:id="@+id/libraryPagerBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_pager_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnLibraryPrevPage"
            android:layout_width="@dimen/lx_pager_button_width"
            android:layout_height="@dimen/lx_pager_button_height"
            android:src="@drawable/ic_chevron_left"
            android:background="@drawable/bg_btn_secondary"
            android:scaleType="centerInside"
            android:padding="@dimen/lx_space_sm"
            android:focusable="true"
            android:nextFocusUp="@id/rvPlaylists"
            android:nextFocusRight="@id/btnLibraryNextPage"
            android:nextFocusDown="@id/tabLibrary"
            app:tint="@color/selector_action_content" />

        <TextView
            android:id="@+id/tvLibraryPageNumber"
            android:layout_width="@dimen/lx_pager_number_width"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textSize="@dimen/lx_type_section"
            android:textStyle="bold"
            android:textColor="@color/lx_text_secondary" />

        <ImageButton
            android:id="@+id/btnLibraryNextPage"
            android:layout_width="@dimen/lx_pager_button_width"
            android:layout_height="@dimen/lx_pager_button_height"
            android:src="@drawable/ic_chevron_right"
            android:background="@drawable/bg_btn_secondary"
            android:scaleType="centerInside"
            android:padding="@dimen/lx_space_sm"
            android:focusable="true"
            android:nextFocusUp="@id/rvPlaylists"
            android:nextFocusLeft="@id/btnLibraryPrevPage"
            android:nextFocusDown="@id/tabLibrary"
            app:tint="@color/selector_action_content" />

    </LinearLayout>

    <!-- Main Content: Songs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSongs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/lx_title_gutter"
        android:paddingEnd="@dimen/lx_title_gutter"
        android:paddingTop="@dimen/lx_nav_gutter"
        android:layout_marginTop="@dimen/lx_space_sm"
        android:paddingBottom="@dimen/lx_nav_gutter"
        android:visibility="gone"
        android:focusable="false"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:nextFocusLeft="@id/tabLibrary"
        android:nextFocusUp="@id/btnPlayAllSongs"
        android:nextFocusDown="@id/btnLibraryNextPage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/libraryActionBar"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
