<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- Top Left Header: Logo + Settings -->
    <LinearLayout
        android:id="@+id/layoutHeaderLeft"
        android:layout_width="300dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="16dp"
        android:background="#40000000"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="洛雪音乐"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F3F4F6"
            android:layout_marginStart="12dp"/>

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/btn_focused_circle"
            android:src="@drawable/ic_settings"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="#9CA3AF"
            android:focusable="true"
            android:contentDescription="Settings" />

    </LinearLayout>

    <!-- Top Right Header: Playlist Name + Count -->
    <LinearLayout
        android:id="@+id/layoutHeaderRight"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        app:layout_constraintStart_toEndOf="@+id/layoutHeaderLeft"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tab: 全部歌曲 -->
        <TextView
            android:id="@+id/tabAllSongs"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="全部歌曲"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:background="@drawable/bg_tab_selected"
            android:focusable="true" />

        <!-- Tab: 我的收藏 -->
        <TextView
            android:id="@+id/tabLoveList"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="我的收藏"
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginStart="8dp"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvPlaylistTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="歌单"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F3F4F6" />

        <TextView
            android:id="@+id/tvSongCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 首"
            android:textSize="14sp"
            android:textColor="#9CA3AF"
            android:layout_marginStart="12dp" />

    </LinearLayout>

    <!-- Left Column: Playlists List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPlaylists"
        android:layout_width="300dp"
        android:layout_height="0dp"
        android:background="#40000000"
        android:padding="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderLeft"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Main Content: Songs -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvSongs"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:padding="24dp"
        app:layout_constraintStart_toEndOf="@+id/rvPlaylists"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeaderRight"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
