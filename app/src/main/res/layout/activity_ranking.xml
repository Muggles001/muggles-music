<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient"
    android:nextFocusLeft="@id/tabRanking">

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_title_height"
        android:orientation="horizontal"
        android:gravity="top"
        android:paddingStart="@dimen/lx_title_gutter"
        android:paddingEnd="@dimen/lx_title_gutter"
        android:paddingTop="@dimen/lx_title_top"
        android:background="@android:color/transparent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/btn_focused_circle"
            android:scaleType="centerInside"
            android:padding="8dp"
            app:tint="@color/lx_text_primary"
            android:focusable="true"
            android:nextFocusRight="@id/rvSourceList"
            android:contentDescription="返回" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="排行榜"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/lx_text_primary"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <!-- Source List + Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutSourceActions"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_secondary_nav_height"
        android:layout_marginStart="@dimen/lx_nav_gutter"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="@dimen/lx_nav_gutter"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_floating_glass"
        android:elevation="8dp"
        android:outlineProvider="background"
        android:clipToOutline="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/topBar">

        <!-- Source List (Platform) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSourceList"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:paddingStart="@dimen/lx_nav_gutter"
            android:paddingEnd="@dimen/lx_nav_gutter"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:clipToPadding="false"
            android:nextFocusLeft="@id/tabRanking" />

        <!-- Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutActions"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnPlayAll"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_play"
                android:background="@drawable/btn_focused_circle"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:focusable="true"
                android:nextFocusRight="@id/btnShuffle"
                android:nextFocusDown="@id/rvSongs"
                android:contentDescription="播放全部" />

            <ImageButton
                android:id="@+id/btnShuffle"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_shuffle"
                android:background="@drawable/btn_focused_circle"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:focusable="true"
                android:nextFocusLeft="@id/btnPlayAll"
                android:nextFocusRight="@id/btnFavorite"
                android:nextFocusDown="@id/rvSongs"
                android:contentDescription="随机播放" />

            <ImageButton
                android:id="@+id/btnFavorite"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_favorite_border"
                android:background="@drawable/btn_focused_circle"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:focusable="true"
                android:nextFocusLeft="@id/btnShuffle"
                android:nextFocusDown="@id/rvSongs"
                android:contentDescription="收藏" />

        </LinearLayout>

    </LinearLayout>

    <!-- Board selector + songs. Boards are a compact secondary strip rather
         than a second sidebar, matching the library hierarchy. -->
    <LinearLayout
        android:id="@+id/layoutContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        android:paddingTop="24dp"
        android:layout_marginTop="12dp"
        android:descendantFocusability="afterDescendants"
        android:splitMotionEvents="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutSourceActions"
        app:layout_constraintBottom_toTopOf="@+id/rankingPagerBar">

        <!-- Secondary board selector -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvBoards"
            android:layout_width="match_parent"
            android:layout_height="@dimen/lx_secondary_nav_height"
            android:paddingStart="@dimen/lx_nav_gutter"
            android:paddingEnd="@dimen/lx_nav_gutter"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_floating_glass"
            android:elevation="6dp"
            android:outlineProvider="background"
            android:clipToOutline="true"
            android:clipToPadding="false"
            android:focusable="false"
            android:nextFocusLeft="@id/tabRanking"
            android:nextFocusDown="@id/rvSongs" />

        <!-- Right: Song List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSongs"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="16dp"
            android:paddingStart="16dp"
            android:paddingEnd="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="16dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:nextFocusLeft="@id/tabRanking"
            android:nextFocusUp="@id/rvBoards"
            android:nextFocusDown="@id/btnRankingNextPage" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/rankingPagerBar"
        android:layout_width="0dp"
        android:layout_height="@dimen/lx_pager_height"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@android:color/transparent"
        android:paddingStart="@dimen/lx_nav_gutter"
        android:paddingEnd="@dimen/lx_nav_gutter"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageButton
            android:id="@+id/btnRankingPrevPage"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_left"
            android:background="@drawable/bg_btn_secondary"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:focusable="true"
            android:nextFocusUp="@id/rvSongs"
            android:nextFocusRight="@id/btnRankingNextPage"
            android:nextFocusDown="@id/tabRanking"
            app:tint="@color/lx_text_primary" />

        <TextView
            android:id="@+id/tvRankingPageNumber"
            android:layout_width="72dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="1"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/lx_text_secondary" />

        <ImageButton
            android:id="@+id/btnRankingNextPage"
            android:layout_width="64dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_chevron_right"
            android:background="@drawable/bg_btn_secondary"
            android:scaleType="centerInside"
            android:padding="12dp"
            android:focusable="true"
            android:nextFocusUp="@id/rvSongs"
            android:nextFocusLeft="@id/btnRankingPrevPage"
            android:nextFocusDown="@id/tabRanking"
            app:tint="@color/lx_text_primary" />

    </LinearLayout>

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/loadingProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
